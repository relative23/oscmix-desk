# oscmix-desk routing configuration
#
# Copied to ~/.config/oscmix/routing.conf on install (only if none exists).
# Everything below is applied to the Fireface's hardware mixer every time
# the backend starts, so the device state is predictable after every boot
# and hotplug. A file may declare routes, channel state, EQ, dynamics,
# reverb, the clock -- or only some of those. Routes are not required.
#
# A route rewrites exactly the registers it declares, and nothing else.
# Whatever you change in oscmix-gtk survives every restart unless a route
# declares that same register -- so mute, EQ and (unless you add a
# 'volume' line) the output faders are yours to keep.
#
# After editing:  systemctl --user reload oscmix.service
# That re-reads this file and re-applies what it pins, leaving what it
# remembers where you put it. A `restart` works too and re-applies all.

[device]
# ALSA sequencer client name to wait for (substring match).
name = Fireface UCX II
# USB vendor:product ID, used to tell "not plugged in" apart from
# "plugged in but the driver failed".
usb-id = 2a39:3fd9
# Which box, when the machine has more than one interface of the same
# model: the number printed on it, which also appears in the ALSA card
# list. Leave it out with one interface. With two and no serial, every
# writer of either shares one lock rather than racing on two.
#serial = 24216011

[osc]
# UDP port the oscmix backend listens on.
port = 7222
# Port oscmix reports state changes to. Used to verify the routing after
# applying it (and by oscmix-gtk while the mixer window is open).
# recv-port = 8222
# Both ports are passed through to the oscmix backend. oscmix-gtk keeps
# its own connection settings, so adjust those too if you change these.

# --------------------------------------------------------------------------
# Routes: [route:<any-name>] sections, applied in file order.
#
#   playback  software playback channel(s):  a pair "1/2" or a single "3"
#   input     hardware input channel(s) instead of playback -- direct
#             monitoring, latency-free, straight from the converter
#   output    hardware output channel(s), same shape as the source
#   level     mix gain in dB   (0 = unity, -65 = mute; default 0)
#   volume    optional: pins the hardware output fader, in dB
#   stereo    stereo-link the output pair (default true for pairs)
#
# 'level' is the routing itself -- how much of the playback pair reaches
# the output -- and is always written. 'volume' is the output fader, the
# knob you would reach for to set listening level. Adding it means every
# backend start forces the fader back to that value, which is what you
# want for a fixed installation and what you do NOT want if you set your
# monitor level by hand. Leave it out to keep the fader under your
# control.
#
# The trade-off, measured rather than guessed: a route without 'volume'
# is applied correctly and can still produce no sound, because the fader
# it does not touch may be all the way down. `make verify-hardware`
# catches that and names the fader; nothing in the routing itself can,
# because at message level the route is perfect. Pin 'volume' on any
# output whose level you do not set by hand.
#
# A route has exactly one source: 'playback' or 'input', never both.
#
# 'input' routes a hardware input straight to an output inside the
# device -- the monitoring path a tracking session needs, with no
# round trip through the computer and no latency. It is also the one
# thing here the device reports back: unlike the playback matrix,
# '/mix/<out>/input/<in>' appears in the state dump, so an input route
# is verified after every start rather than only re-applied.
#
# NOTE: a config using 'input' is rejected whole by 0.2.0 and earlier
# (then called oscmix-autostart) -- an unknown option in a known section
# is an error there, on purpose. A monitoring route that vanished with a warning
# would be worse than one that refuses to start.
#
# PipeWire/PulseAudio send stereo audio to playback 1/2, so most setups
# only need to route 1/2 to wherever their speakers are connected.
# --------------------------------------------------------------------------

# Main outputs (headphones on the UCX II front panel are outputs 1/2).
[route:main-out]
playback = 1/2
output = 1/2
level = 0.0

# Example: studio monitors connected to outputs 5/6 on the rear panel.
# Deliberately without 'volume', so the monitor level stays where you
# leave it in the mixer.
# [route:monitors]
# playback = 1/2
# output = 5/6
# level = 0.0

# Example: direct monitoring while tracking. Inputs 1/2 (the mic pres on
# a UCX II) straight to the headphones, with no computer in the path.
# 'level' is the monitoring level; the performer's mix, not yours.
# [route:direct-monitor]
# input = 1/2
# output = 7/8
# level = -6.0

# --------------------------------------------------------------------------
# Channel state: [input:N] and [output:N]
#
# Settings that survive a reboot, applied after the routing. Which
# options a channel has is the device's business, not this file's --
# the mic preamps (1/2) have gain but no reference level, inputs 3-8
# have reflevel, hi-z is on 3/4 only. Asking for one a channel does not
# have is an error naming the channels that do.
#
#   [input:3]
#   gain = 12.0          # dB, range depends on the channel
#   reflevel = +19dBu    # the device's own names: +13dBu, +19dBu
#   hi-z = true
#
#   [output:5]
#   volume = -10.0       # dB; pins the fader on every start
#   mute = false
#   reflevel = +4dBu     # outputs: +4dBu, +13dBu, +19dBu
#
# PHANTOM POWER IS NOT SETTABLE HERE. '48v' is deliberately left out
# until a hardware measurement proves the channel a config names is the
# channel the device powers. An off-by-one in a silent output is a bug;
# an off-by-one in phantom power is a damaged ribbon microphone. Set it
# in the mixer for now.
#
# These sections make a config unreadable by 0.2.0 and earlier, which
# reject unknown sections' options rather than guessing.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# The rest of the strip: nested and global sections (since 0.4.0)
#
# Per-channel families with more than one register sit in a section of
# their own, named [<family>:<input|output>:<n>]. Families with no
# channel at all are a plain [<family>]. Every option name and every
# bound is the device's own; a value outside the register's range is
# refused before anything reaches the hardware.
#
#   [eq:input:3]              # three-band EQ; also [eq:output:N]
#   enabled = true
#   band1freq = 80            # Hz
#   band1gain = -3.0          # dB
#   band1type = Low Shelf
#
#   [dynamics:output:5]       # compressor and expander
#   enabled = true
#   compthres = -18.0
#   compratio = 4.0
#
#   [lowcut:input:1]          # also: [autolevel:...], [roomeq:output:N]
#   enabled = true
#   freq = 80
#
#   [clock]                   # channel-less families: clock, hardware,
#   source = Internal         # controlroom, reverb, echo
#
#   [reverb]
#   enabled = false
#
# `oscmix-session --dump-config` prints the desk you already have in
# exactly this shape, which is the easiest way to see every option and
# its current value.
# --------------------------------------------------------------------------

# ---------------------------------------------------------------------
# Profiles
# ---------------------------------------------------------------------
# A profile is a complete routing.conf in a 'profiles' directory beside
# this one:
#
#     ~/.config/oscmix/routing.conf
#     ~/.config/oscmix/profiles/tracking.conf
#     ~/.config/oscmix/profiles/mixdown.conf
#
#     oscmix-session --list-profiles
#     oscmix-session --profile tracking
#
# Not a new section type on purpose: a profile is parsed by the same
# code as this file, follows the same compatibility rule, and
# '--dump-config > profiles/tracking.conf' composes without anything
# extra.
#
# Leave [osc] and [device] out of a profile. Those describe the machine,
# not the desk, and are inherited from this file unless the profile
# states them itself -- a profile that restates them is wrong the moment
# it is copied to another machine, or silently right, which is worse.
#
# A switch reports exactly one of three outcomes and never half-applies:
#
#   applied 'tracking' and verified it at the device
#   applied 'tracking'; 1 register(s) this backend cannot report: ...
#   refused 'tracking', nothing written: [route:x] output: channel 99 ...
#
# A refusal costs nothing -- the config is parsed and validated in full
# before the first datagram, so a typo costs you an error message and
# not your monitoring. See
# docs/decisions/0011-a-profile-switch-states-its-outcome.md.

# ---------------------------------------------------------------------
# Pin and remember
# ---------------------------------------------------------------------
# Every setting written here is either pinned -- the config wins, and is
# re-sent if the device disagrees -- or remembered -- set once at start,
# and after that the mixer wins.
#
# The defaults follow what a setting is. The routing itself, channel
# links, 'reflevel', 'gain' and 'hi-z' are pinned: they describe what is
# physically plugged in, and a wrong value is a signal problem. ('48v'
# is modelled as pinned too, and stays unsettable -- see above.)
# 'volume', 'mute' and 'phase' are remembered: turn a monitor fader
# during a session and it stays turned.
#
# Override per option where your setup disagrees:
#
#     [pin]
#     output.volume = pin      # fixed install, levels set once
#     input.gain = remember    # gain ridden by hand
#
# Pinning does NOT mean the value snaps back the moment you change it in
# the mixer. It cannot: of everything a config sets, this device
# announces only channel links when they change -- measured. Everything
# else is silent until a full state dump is requested. Pinning means
# this session insists, through the read-back after start.
#
# See docs/decisions/0012-pin-and-remember.md.
