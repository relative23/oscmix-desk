#!/usr/bin/python3 -I
"""Keep package replacement/removal separate from running mixer processes."""

import argparse
import errno
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

FENCE = Path('/var/lib/oscmix-desk/package-update')
GTK_FENCE = Path('/var/lib/oscmix-desk/gtk-package-update')
BACKUPS = Path('/var/lib/oscmix-desk/legacy-system')
CACHE = Path('/usr/lib/oscmix-desk/oscmix_desk/__pycache__')
SYSTEM_FILES = (
    '/usr/lib/systemd/system-sleep/oscmix', '/usr/lib/tmpfiles.d/oscmix-desk.conf',
    '/usr/bin/oscmix', '/usr/bin/alsaseqio', '/usr/bin/oscmix-gtk',
    '/usr/bin/oscmix-session', '/usr/bin/oscmix-launch',
)


def running(proc=Path('/proc')):
    found = []
    names = {'oscmix-session', 'oscmix', 'alsaseqio', 'oscmix-gtk'}
    for entry in proc.iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            args = (entry / 'cmdline').read_bytes().split(b'\0')
        except FileNotFoundError:
            continue
        if any(Path(os.fsdecode(arg)).name in names for arg in args if arg):
            found.append(entry.name)
    return found


def require_stopped():
    pids = running()
    if pids:
        raise ValueError('stop mixer services, manual sessions and companion mixers before '
                         'changing the package; still running PIDs: ' + ', '.join(pids))


def owned(path):
    for tool, arguments in (('dpkg-query', ['-S']), ('rpm', ['-qf']), ('pacman', ['-Qo'])):
        if shutil.which(tool):
            result = subprocess.run([tool, *arguments, str(path)], capture_output=True,
                                    check=False, timeout=20)
            return result.returncode == 0
    return False


def preserve_unowned():
    files = [Path(name) for name in SYSTEM_FILES if Path(name).exists() and not owned(Path(name))]
    if not files:
        return
    BACKUPS.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix='before-package-', dir=str(BACKUPS)))
    manifest = []
    for path in files:
        saved = backup / path.relative_to('/')
        saved.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, saved, follow_symlinks=False)
        metadata = path.lstat()
        os.chown(saved, metadata.st_uid, metadata.st_gid, follow_symlinks=False)
        manifest.append({'original': str(path), 'backup': str(saved)})
    (backup / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print('Unowned system files preserved in ' + str(backup), flush=True)


def begin(backup=False, fence=None):
    fence = FENCE if fence is None else fence
    already_fenced = fence.exists()
    fence.parent.mkdir(parents=True, exist_ok=True)
    fence.touch(mode=0o644, exist_ok=True)
    try:
        require_stopped()
        if backup:
            preserve_unowned()
    except (OSError, ValueError):
        if not already_fenced:
            fence.unlink()
        raise


def clean_bytecode():
    """Remove only generated bytecode; keep unknown files and user configuration."""
    if not CACHE.is_dir() or CACHE.is_symlink():
        return
    for path in CACHE.glob('*.pyc'):
        if path.is_file() or path.is_symlink():
            path.unlink()
    try:
        CACHE.rmdir()
    except OSError as exc:
        if exc.errno != errno.ENOTEMPTY:
            raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['check', 'install', 'remove', 'finish'])
    parser.add_argument('--component', choices=['core', 'gtk'], default='core')
    args = parser.parse_args()
    fence = GTK_FENCE if args.component == 'gtk' else FENCE
    if os.getuid() != 0:
        parser.error('package maintenance runs as root')
    try:
        if args.action == 'check':
            require_stopped()
        elif args.action == 'install':
            begin(backup=True, fence=fence)
        elif args.action == 'remove':
            begin(fence=fence)
            if args.component == 'core':
                clean_bytecode()
        else:
            fence.unlink(missing_ok=True)
    except (OSError, ValueError, subprocess.SubprocessError) as exc:
        print('oscmix-desk package: ' + str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
