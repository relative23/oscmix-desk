[Unit]
Description=oscmix backend for RME Fireface interfaces
Documentation=https://github.com/michaelforney/oscmix
After=sound.target
# Started on hotplug via the udev rule (SYSTEMD_USER_WANTS); stops again
# when the pull-in from the device disappears.
StopWhenUnneeded=yes
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# oscmix-session sends READY=1 once the backend is up and the routing
# has been applied; verification then runs in the background.
Type=notify
ExecStart=%h/.local/bin/oscmix-session
# The device lock lives here since 0.6.7, keyed by the interface rather
# than by a config directory (ADR 0022). systemd creates it under
# $XDG_RUNTIME_DIR for this user; the unit cannot create it under its
# own read-only home, and a lock it cannot take is a start it refuses.
RuntimeDirectory=oscmix-desk
RuntimeDirectoryPreserve=yes
# Reconcile without restarting: re-read routing.conf, read the device
# back, and re-apply what the config pins -- leaving alone what it
# remembers (ADR 0012, ADR 0013).
#
# $MAINPID and not `systemctl kill`. That was measured the hard way:
# `systemctl --user kill --signal=SIGHUP oscmix.service` signals *every*
# process in the unit, and neither oscmix nor alsaseqio handles SIGHUP,
# so the default action applies and the backend dies. The service went
# inactive. ExecReload reaches the session process alone.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=3
# Exit code 2 means a routing.conf error -- restarting cannot fix that.
RestartPreventExitStatus=2
# The worst case to READY=1 is constants.startup_budget(): the device
# wait, the stale-backend settle, the port wait, the link barrier and,
# since the start holds the device lock, the lock wait (0.6.9 found that
# term missing). tests/test_unit_file.py keeps 10 s of margin on it.
TimeoutStartSec=100
TimeoutStopSec=10

# Sandboxing, restricted to what a *user* unit can actually enforce.
# Anything that drops capabilities (ProtectKernelTunables, ProtectClock,
# RestrictSUIDSGID, ...) or needs a cgroup controller (DeviceAllow,
# IPAddress*) fails here with 218/CAPABILITIES: the user manager is
# unprivileged and cannot apply them. Verified by starting the unit, not
# by reading the manual.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# OSC is UDP on loopback and readiness is a UNIX datagram; nothing here
# has any business opening another kind of socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
KeyringMode=private
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The config lives under ~/.config and is only ever read. The one write
# is the device lock in the shared lock directory. Where a user manager
# can apply ProtectSystem=strict, /run is read-only without this line and
# no lock file can be created -- measured under the system manager, which
# applies the sandbox; Ubuntu's user manager silently does not, because
# AppArmor denies it the mount namespace (docs/SECURITY-MODEL.md). The
# dash: a machine without the directory falls back to RuntimeDirectory=.
ReadWritePaths=-/run/oscmix-desk

[Install]
WantedBy=default.target
