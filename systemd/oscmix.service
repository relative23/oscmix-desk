[Unit]
Description=oscmix backend for RME Fireface interfaces
Documentation=https://github.com/michaelforney/oscmix
After=sound.target
# Started on hotplug via the udev rule (SYSTEMD_USER_WANTS). On unplug
# the backend exits with its device and the session exits 0; this
# directive would also stop a service that only the pull-in started, but
# an enabled unit is wanted by default.target and never unneeded.
StopWhenUnneeded=yes
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# oscmix-session sends READY=1 once the backend is up and the routing
# has been applied; verification then runs in the background.
Type=notify
ExecStart=%h/.local/bin/oscmix-session
# The fallback location of the device lock: /run/oscmix-desk, created
# by tmpfiles.d for the group audio, comes first (ADR 0023, 0024), and
# this per-user runtime directory serves a machine whose installer never
# ran its root steps. A lock the unit cannot take is a start it refuses.
RuntimeDirectory=oscmix-desk
RuntimeDirectoryPreserve=yes
# Reconcile without restarting: re-read the desk in effect (the active
# profile, else routing.conf), read the device back, and re-apply what
# the config pins -- leaving alone what it remembers (ADR 0012, ADR 0013,
# ADR 0018).
#
# $MAINPID and not `systemctl kill`. That was measured the hard way:
# `systemctl --user kill --signal=SIGHUP oscmix.service` signals *every*
# process in the unit, and neither oscmix nor alsaseqio handles SIGHUP,
# so the default action applies and the backend dies. The service went
# inactive. ExecReload reaches the session process alone.
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=3
# Exit code 2 means a configuration the unit cannot run: a routing.conf
# error, two interfaces and no [device] serial to choose, or a session
# already running on the port. Restarting cannot fix any of them.
RestartPreventExitStatus=2
# The worst case to READY=1 is constants.startup_budget(): the device
# wait, the stale-backend settle, the port wait, the link barrier and,
# since the start holds the device lock, the lock wait (0.6.9 found that
# term missing). tests/test_unit_file.py keeps 10 s of margin on it.
TimeoutStartSec=100
TimeoutStopSec=10

# Sandboxing, restricted to what a *user* unit can actually enforce.
# Directives that need a cgroup controller (DeviceAllow, IPAddress*)
# fail here with 218/CAPABILITIES. Every directive below was verified by
# starting the unit, not by reading the manual -- tests/test_unit_file.py
# keeps the measured list. Whether the mount-namespace ones
# (ProtectSystem, ProtectHome, PrivateTmp) are *applied* depends on the
# distribution: Ubuntu's AppArmor policy makes the user manager skip
# them silently (docs/SECURITY-MODEL.md says how to check).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# OSC is UDP on loopback and readiness is a UNIX datagram; nothing here
# has any business opening another kind of socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
KeyringMode=private
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# The config lives under ~/.config and is only ever read. The one write
# is the device lock in the shared lock directory. Where a user manager
# can apply ProtectSystem=strict, /run is read-only without this line and
# no lock file can be created -- measured under the system manager, which
# applies the sandbox; Ubuntu's user manager silently does not, because
# AppArmor denies it the mount namespace (docs/SECURITY-MODEL.md). The
# dash: a machine without the directory falls back to RuntimeDirectory=.
ReadWritePaths=-/run/oscmix-desk

[Install]
WantedBy=default.target
