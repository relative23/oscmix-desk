#!/bin/sh
# systemd keeps user.slice frozen throughout both sleep-hook phases.
# Queue one system job without waiting; its ordering postpones the user
# manager calls until systemd-sleep has thawed that slice.
case "${1:-}" in
    post) exec systemctl --no-block start oscmix-resume.service ;;
    reload-active) ;; # Only the ordered system service uses this phase.
    *) exit 0 ;;
esac

users=$(loginctl list-users --no-legend) || exit 1
status=0
for user in $(printf '%s\n' "$users" | awk '{print $2}'); do
    # Reload cannot activate an absent or stopped desk. Check first so
    # ordinary inactive users are quiet while actual reload failures are
    # visible in the system service's journal. ExecReload signals only the
    # session's main process, preserving the backend and REMEMBER values.
    if systemctl --user --machine="${user}@.host" is-active --quiet oscmix.service; then
        if ! systemctl --user --machine="${user}@.host" reload oscmix.service; then
            echo "oscmix: resume reload failed for $user" >&2
            status=1
        fi
    fi
done
exit "$status"
