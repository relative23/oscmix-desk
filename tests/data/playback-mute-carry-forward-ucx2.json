 "source_diff": "--- a/oscmix.c\n+++ b/oscmix.c\n@@ -648,3 +648,3 @@\n \t\treturn;\n-\tputle32(buf, val << 7 | ctx->param.in);\n+\tputle32(buf, val << 7 | ctx->param.out);\n \twritesysex(3, buf, sizeof buf, sysexbuf);\n--- a/control.c\n+++ b/control.c\n@@ -387,2 +387,6 @@\n \t\t\tint result = control_command(data, len);\n+\t\t\t/* A WRITE proves its owner alive as a KEEPALIVE does, timed\n+\t\t\t * after the command: MIDI may hold one up for seconds. */\n+\t\t\tif (has_lease(index, token))\n+\t\t\t\tidle_until = now() + LEASE_IDLE;\n \t\t\treply(index, kind, request, result < 0 ? CONTROL_INVALID : CONTROL_OK);\n--- a/desk-build-id.h\n+++ b/desk-build-id.h\n@@ -1 +1 @@\n-#define OSCMIX_DESK_BUILD_ID \"ed304b2afb25adceb20b3cdc83e4d1d4ef640d7a655ed04c2605fcde805dae2c\"\n+#define OSCMIX_DESK_BUILD_ID \"75f8a9673b57891291c9511c2999b8f6a761b41bfd50632fa61efc3998daba3b\"\n--- a/gtk/main.c\n+++ b/gtk/main.c\n@@ -545,3 +545,3 @@\n \tmixer_bind(self->osc, \"/reverb/time\", G_TYPE_FLOAT, self->reverb_time, \"value\");\n-\tmixer_bind(self->osc, \"/reverb/damp\", G_TYPE_INT, self->reverb_damp, \"value\");\n+\tmixer_bind(self->osc, \"/reverb/highdamp\", G_TYPE_INT, self->reverb_damp, \"value\");\n \tmixer_bind(self->osc, \"/reverb/smooth\", G_TYPE_INT, self->reverb_smooth, \"value\");\n",
