+/* One absolute budget for the whole coordinated MIDI frame, including
+ * repeated EINTR and partial progress. The descriptor is nonblocking. */
+static int
+midiremaining(const struct timespec *start)
+{
+	struct timespec current;
+	int64_t elapsed;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &current) < 0)
+		fatal("clock_gettime MIDI write:");
+	elapsed = (int64_t)(current.tv_sec - start->tv_sec) * INT64_C(1000000000) +
+	    current.tv_nsec - start->tv_nsec;
+	if (elapsed < 0)
+		fatal("MIDI monotonic clock moved backwards");
+	if (elapsed >= INT64_C(2000000000))
+		fatal("MIDI bridge write timed out");
+	return (INT64_C(2000000000) - elapsed + 999999) / 1000000;
+}
