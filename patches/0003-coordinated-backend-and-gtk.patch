+void
+mixer_start(Mixer *self, const char *path, pid_t expected_pid)
+{
+	GSocketAddress *address;
+	GError *error = NULL;
+	struct ucred peer;
+	socklen_t length = sizeof peer;
+	if (!path || !*path || expected_pid <= 0) {
+		changed(self);
+		return;
+	}
+	self->socket = g_socket_new(G_SOCKET_FAMILY_UNIX, G_SOCKET_TYPE_SEQPACKET,
+	                           G_SOCKET_PROTOCOL_DEFAULT, &error);
+	if (!self->socket)
+		goto failed;
+	g_socket_set_timeout(self->socket, 2);
+	address = g_unix_socket_address_new(path);
+	bool connected = g_socket_connect(self->socket, address, NULL, &error);
+	g_object_unref(address);
+	if (!connected)
+		goto failed;
+	if (getsockopt(g_socket_get_fd(self->socket), SOL_SOCKET, SO_PEERCRED, &peer, &length) < 0 ||
+	    length != sizeof peer || peer.pid != expected_pid)
+		goto failed;
+	self->backend_pid = peer.pid;
+	/* The connect deadline must not become an idle receive timeout. */
+	g_socket_set_timeout(self->socket, 0);
+	g_socket_set_blocking(self->socket, false);
+	self->source = g_socket_create_source(self->socket, G_IO_IN | G_IO_HUP | G_IO_ERR, NULL);
+	g_source_set_callback(self->source, (GSourceFunc)on_control_data, self, NULL);
+	g_source_attach(self->source, NULL);
+	self->hello_timeout = g_timeout_add(3000, hello_expired, self);
+	unsigned char sources[4];
+	putbe32(sources, CONTROL_DEVICE | CONTROL_DERIVED | CONTROL_METERS);
