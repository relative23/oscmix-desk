diff --git a/control.c b/control.c
new file mode 100644
index 0000000000000000000000000000000000000000..c376752106b0a495ebf254898b7f03315bcf3976
--- /dev/null
+++ b/control.c
@@ -0,0 +1,568 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <time.h>
+#include <unistd.h>
+#include "control.h"
+#include "osc.h"
+
+#define QUEUE_PACKETS 32
+#define QUEUE_BYTES (256 * 1024)
+#define LEASE_IDLE 5.0
+#define LEASE_TOTAL 90.0
+#define REFRESH_WINDOW 10.0
+#define HELLO_TIMEOUT 3.0
+
+struct packet {
+	size_t len;
+	unsigned char data[CONTROL_PACKET];
+};
+
+struct client {
+	int fd;
+	unsigned role, sources;
+	uint32_t request;
+	double accepted;
+	bool refresh;
+	struct packet queue[QUEUE_PACKETS];
+	unsigned head, count;
+	size_t bytes;
+};
+
+static struct client clients[CONTROL_CLIENTS];
+static int server = -1, ownerlock = -1, owner = -1;
+static char socketpath[sizeof ((struct sockaddr_un *)0)->sun_path];
+static dev_t socketdev;
+static ino_t socketino;
+static unsigned char epoch[16];
+static char device_name[256];
+static uint64_t generation = 1, observation, window;
+static double idle_until, hard_until, refresh_until;
+static bool refreshing;
+
+static double
+now(void)
+{
+	struct timespec ts;
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) < 0)
+		abort();
+	return ts.tv_sec + ts.tv_nsec / 1e9;
+}
+
+static uint32_t
+get32(const unsigned char *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static uint64_t
+get64(const unsigned char *p)
+{
+	return (uint64_t)get32(p) << 32 | get32(p + 4);
+}
+
+static void
+put32(unsigned char *p, uint32_t n)
+{
+	p[0] = n >> 24;
+	p[1] = n >> 16;
+	p[2] = n >> 8;
+	p[3] = n;
+}
+
+static void
+put64(unsigned char *p, uint64_t n)
+{
+	put32(p, n >> 32);
+	put32(p + 4, n);
+}
+
+static void disconnect(int index);
+static void state_changed(void);
+
+static void
+release_owner(void)
+{
+	owner = -1;
+	++generation;
+	state_changed();
+}
+
+static void
+disconnect(int index)
+{
+	struct client *c = &clients[index];
+	if (c->fd < 0)
+		return;
+	close(c->fd);
+	c->fd = -1;
+	c->count = 0;
+	c->bytes = 0;
+	c->refresh = false;
+	if (owner == index)
+		release_owner();
+}
+
+static void
+flush(int index)
+{
+	struct client *c = &clients[index];
+	ssize_t sent;
+	while (c->fd >= 0 && c->count) {
+		struct packet *p = &c->queue[c->head];
+		sent = send(c->fd, p->data, p->len, MSG_DONTWAIT | MSG_NOSIGNAL);
+		if (sent < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+			return;
+		if (sent < 0 && errno == EINTR)
+			continue;
+		if (sent != (ssize_t)p->len) {
+			disconnect(index);
+			return;
+		}
+		c->bytes -= p->len;
+		c->head = (c->head + 1) % QUEUE_PACKETS;
+		--c->count;
+	}
+}
+
+static void
+enqueue(int index, uint32_t kind, uint32_t request, uint32_t code,
+        uint64_t sequence, const void *data, size_t len)
+{
+	struct client *c = &clients[index];
+	struct packet *p;
+	if (c->fd < 0)
+		return;
+	if (len > CONTROL_PAYLOAD || c->count == QUEUE_PACKETS ||
+	    c->bytes + CONTROL_HEADER + len > QUEUE_BYTES) {
+		fprintf(stderr, "control: disconnecting slow consumer\n");
+		disconnect(index);
+		return;
+	}
+	p = &c->queue[(c->head + c->count) % QUEUE_PACKETS];
+	memcpy(p->data, "ODK1", 4);
+	put32(p->data + 4, kind);
+	put32(p->data + 8, request);
+	put32(p->data + 12, code);
+	put64(p->data + 16, sequence);
+	if (len)
+		memcpy(p->data + CONTROL_HEADER, data, len);
+	p->len = CONTROL_HEADER + len;
+	c->bytes += p->len;
+	++c->count;
+	flush(index);
+}
+
+static void
+reply(int index, uint32_t kind, uint32_t request, uint32_t code)
+{
+	enqueue(index, kind | CONTROL_REPLY, request, code, generation, NULL, 0);
+}
+
+static void
+state_changed(void)
+{
+	int i;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		if (clients[i].fd >= 0 && clients[i].role)
+			enqueue(i, CONTROL_EVENT, 0, owner < 0 ? CONTROL_OK : CONTROL_BUSY,
+			        generation, NULL, 0);
+}
+
+void
+control_broadcast(const void *buf, size_t len, unsigned source)
+{
+	int i;
+	++observation;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		if (clients[i].fd >= 0 && (clients[i].sources & source))
+			enqueue(i, CONTROL_OBSERVATION, 0, source, observation, buf, len);
+}
+
+static void
+window_changed(unsigned code)
+{
+	int i;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		if (clients[i].fd >= 0 && clients[i].role)
+			enqueue(i, CONTROL_WINDOW, 0, code, window, NULL, 0);
+}
+
+static void
+refresh(void)
+{
+	static const unsigned char message[] = "/refresh\0\0\0\0,\0\0\0";
+	int i;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		clients[i].refresh = false;
+	refresh_until = now() + REFRESH_WINDOW;
+	refreshing = true;
+	++window;
+	window_changed(CONTROL_BUSY);
+	control_command(message, sizeof message - 1);
+}
+
+void
+control_tick(void)
+{
+	double current = now();
+	int i;
+	if (owner >= 0 && (current >= idle_until || current >= hard_until)) {
+		fprintf(stderr, "control: operation lease expired\n");
+		disconnect(owner);
+	}
+	if (refreshing && current >= refresh_until) {
+		refreshing = false;
+		window_changed(CONTROL_OK);
+	}
+	for (i = 0; i < CONTROL_CLIENTS; ++i) {
+		struct client *c = &clients[i];
+		if (c->fd < 0)
+			continue;
+		if (!c->role && current - c->accepted >= HELLO_TIMEOUT)
+			disconnect(i);
+		else if (c->refresh && owner < 0 && current >= refresh_until) {
+			refresh();
+			break;
+		}
+	}
+}
+
+static bool
+valid_command(const unsigned char *data, size_t len)
+{
+	const unsigned char *end, *p;
+	struct oscmsg msg = {.buf = (unsigned char *)data, .end = (unsigned char *)data + len};
+	const char *tags;
+	if (!len || len % 4 || data[0] != '/')
+		return false;
+	end = memchr(data, 0, len);
+	if (!end || end == data + 1)
+		return false;
+	/* Refresh cannot bypass the window arbiter via OSC patterns/raw registers. */
+	for (p = data; p != end; ++p)
+		if (*p < 33 || *p > 126 || strchr("*?[]{}", *p))
+			return false;
+	if (!strncmp((const char *)data, "/refresh", 8) ||
+	    !strncmp((const char *)data, "/register", 9))
+		return false;
+	oscgetstr(&msg);
+	tags = oscgetstr(&msg);
+	if (msg.err || !tags || *tags != ',')
+		return false;
+	msg.type = tags + 1;
+	while (!msg.err && *msg.type) {
+		switch (*msg.type) {
+		case 'i': oscgetint(&msg); break;
+		case 'f': if (!isfinite(oscgetfloat(&msg))) return false; break;
+		case 's': oscgetstr(&msg); break;
+		default: return false;
+		}
+	}
+	return oscend(&msg) == 0;
+}
+
+static bool
+has_lease(int index, uint64_t token)
+{
+	return owner == index && token == generation;
+}
+
+static void
+hello(int index, uint32_t request, uint32_t role, const unsigned char *data, size_t len)
+{
+	unsigned char payload[24 + sizeof device_name];
+	struct client *c = &clients[index];
+	unsigned sources;
+	if (c->role || len != 4 || role < CONTROL_DESK || role > CONTROL_READER) {
+		disconnect(index);
+		return;
+	}
+	sources = get32(data);
+	if (!sources || sources & ~(CONTROL_DEVICE | CONTROL_DERIVED | CONTROL_METERS)) {
+		disconnect(index);
+		return;
+	}
+	c->role = role;
+	c->sources = sources;
+	memcpy(payload, epoch, 16);
+	put32(payload + 16, getpid());
+	put32(payload + 20, 1); /* protocol implementation version, not hardware capability */
+	memcpy(payload + 24, device_name, strlen(device_name) + 1);
+	enqueue(index, CONTROL_HELLO | CONTROL_REPLY, request, CONTROL_OK,
+	        generation, payload, 25 + strlen(device_name));
+	enqueue(index, CONTROL_EVENT, 0, owner < 0 ? CONTROL_OK : CONTROL_BUSY,
+	        generation, NULL, 0);
+}
+
+static void
+dispatch(int index, const unsigned char *packet, size_t len)
+{
+	struct client *c = &clients[index];
+	uint32_t kind, request, code;
+	uint64_t token;
+	const unsigned char *data = packet + CONTROL_HEADER;
+	control_tick();
+	if (c->fd < 0)
+		return;
+	if (len < CONTROL_HEADER || memcmp(packet, "ODK1", 4)) {
+		disconnect(index);
+		return;
+	}
+	kind = get32(packet + 4);
+	request = get32(packet + 8);
+	code = get32(packet + 12);
+	token = get64(packet + 16);
+	len -= CONTROL_HEADER;
+	if (!request || c->request == UINT32_MAX || request != c->request + 1) {
+		disconnect(index);
+		return;
+	}
+	c->request = request;
+	if (kind == CONTROL_HELLO) {
+		hello(index, request, code, data, len);
+		return;
+	}
+	if (!c->role || code || (kind != CONTROL_WRITE && len)) {
+		disconnect(index);
+		return;
+	}
+	switch (kind) {
+	case CONTROL_BEGIN:
+		if (c->role != CONTROL_DESK) {
+			reply(index, kind, request, CONTROL_NOT_OWNER);
+		} else if (owner >= 0) {
+			reply(index, kind, request, CONTROL_BUSY);
+		} else {
+			owner = index;
+			++generation;
+			hard_until = now() + LEASE_TOTAL;
+			idle_until = now() + LEASE_IDLE;
+			reply(index, kind, request, CONTROL_OK);
+			state_changed();
+		}
+		break;
+	case CONTROL_END:
+	case CONTROL_KEEPALIVE:
+		if (!has_lease(index, token)) {
+			reply(index, kind, request, CONTROL_NOT_OWNER);
+		} else {
+			if (kind == CONTROL_END)
+				release_owner();
+			else
+				idle_until = now() + LEASE_IDLE;
+			reply(index, kind, request, CONTROL_OK);
+		}
+		break;
+	case CONTROL_WRITE:
+		if (!(has_lease(index, token) ||
+		      (c->role == CONTROL_GUI && owner < 0 && token == generation))) {
+			reply(index, kind, request, CONTROL_BUSY);
+		} else if (!valid_command(data, len)) {
+			reply(index, kind, request, CONTROL_INVALID);
+		} else {
+			int result = control_command(data, len);
+			reply(index, kind, request, result < 0 ? CONTROL_INVALID : CONTROL_OK);
+		}
+		break;
+	case CONTROL_REFRESH:
+		if ((owner >= 0 && !has_lease(index, token)) || now() < refresh_until) {
+			if (c->role == CONTROL_GUI)
+				c->refresh = true;
+			reply(index, kind, request, CONTROL_BUSY);
+		} else {
+			/* The receipt boundary precedes every reply to this request. */
+			reply(index, kind, request, CONTROL_OK);
+			if (c->fd >= 0)
+				refresh();
+		}
+		break;
+	default:
+		disconnect(index);
+		break;
+	}
+}
+
+static void
+accept_client(void)
+{
+	struct ucred credentials;
+	socklen_t size = sizeof credentials;
+	int fd, i, buffer = 32768;
+	fd = accept4(server, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+	if (fd < 0)
+		return;
+	if (getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &credentials, &size) < 0 ||
+	    size != sizeof credentials || credentials.pid <= 0) {
+		close(fd);
+		return;
+	}
+	for (i = 0; i < CONTROL_CLIENTS && clients[i].fd >= 0; ++i)
+		;
+	if (i == CONTROL_CLIENTS) {
+		close(fd);
+		return;
+	}
+	if (setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &buffer, sizeof buffer) < 0 ||
+	    setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &buffer, sizeof buffer) < 0) {
+		close(fd);
+		return;
+	}
+	memset(&clients[i], 0, sizeof clients[i]);
+	clients[i].fd = fd;
+	clients[i].accepted = now();
+}
+
+void
+control_pollfds(struct pollfd *fds)
+{
+	int i;
+	fds[0] = (struct pollfd){.fd = server, .events = POLLIN};
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		fds[i + 1] = (struct pollfd){.fd = clients[i].fd,
+		    .events = POLLIN | (clients[i].count ? POLLOUT : 0)};
+}
+
+void
+control_dispatch(struct pollfd *fds)
+{
+	int i;
+	unsigned char buffer[CONTROL_PACKET];
+	struct iovec iov = {.iov_base = buffer, .iov_len = sizeof buffer};
+	ssize_t n;
+	control_tick();
+	if (fds[0].revents & POLLIN)
+		accept_client();
+	for (i = 0; i < CONTROL_CLIENTS; ++i) {
+		struct client *c = &clients[i];
+		struct pollfd *fd = &fds[i + 1];
+		struct msghdr msg = {.msg_iov = &iov, .msg_iovlen = 1};
+		if (c->fd < 0 || c->fd != fd->fd)
+			continue;
+		if (fd->revents & (POLLHUP | POLLERR | POLLNVAL)) {
+			disconnect(i);
+			continue;
+		}
+		if (fd->revents & POLLOUT)
+			flush(i);
+		if (c->fd < 0 || !(fd->revents & POLLIN))
+			continue;
+		n = recvmsg(c->fd, &msg, MSG_DONTWAIT);
+		if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR))
+			continue;
+		if (n <= 0 || msg.msg_flags & (MSG_TRUNC | MSG_CTRUNC))
+			disconnect(i);
+		else
+			dispatch(i, buffer, n);
+	}
+}
+
+void
+control_close(void)
+{
+	struct stat st;
+	int i;
+	/* Closing the owner cannot publish a new usable generation on shutdown. */
+	owner = -1;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		disconnect(i);
+	if (server >= 0) {
+		close(server);
+		server = -1;
+	}
+	if (socketino && lstat(socketpath, &st) == 0 &&
+	    st.st_dev == socketdev && st.st_ino == socketino)
+		unlink(socketpath);
+	socketino = 0;
+	if (ownerlock >= 0) {
+		close(ownerlock);
+		ownerlock = -1;
+	}
+}
+
+int
+control_open(const char *path, const char *device)
+{
+	struct sockaddr_un address = {.sun_family = AF_UNIX};
+	struct stat st;
+	char lockpath[sizeof address.sun_path + 7];
+	int i, randomfd, probe, saved;
+	ssize_t received;
+	for (i = 0; i < CONTROL_CLIENTS; ++i)
+		clients[i].fd = -1;
+	if (strlen(path) >= sizeof address.sun_path || strlen(device) >= sizeof device_name) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	strcpy(address.sun_path, path);
+	strcpy(socketpath, path);
+	strcpy(device_name, device);
+	snprintf(lockpath, sizeof lockpath, "%s.owner", path);
+	ownerlock = open(lockpath, O_RDWR | O_CREAT | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK, 0660);
+	if (ownerlock < 0)
+		return -1;
+	if (fstat(ownerlock, &st) < 0 || !S_ISREG(st.st_mode) || st.st_nlink != 1) {
+		errno = EINVAL;
+		goto fail;
+	}
+	if (st.st_uid == geteuid() && fchmod(ownerlock, 0660) < 0)
+		goto fail;
+	if (flock(ownerlock, LOCK_EX | LOCK_NB) < 0)
+		goto fail;
+	if (lstat(path, &st) == 0) {
+		if (!S_ISSOCK(st.st_mode) || st.st_uid != geteuid()) {
+			errno = EEXIST;
+			goto fail;
+		}
+		probe = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+		if (probe < 0)
+			goto fail;
+		i = connect(probe, (struct sockaddr *)&address, sizeof address);
+		saved = errno;
+		close(probe);
+		if (i == 0 || saved != ECONNREFUSED) {
+			errno = EADDRINUSE;
+			goto fail;
+		}
+		if (unlink(path) < 0)
+			goto fail;
+	} else if (errno != ENOENT) {
+		goto fail;
+	}
+	randomfd = open("/dev/urandom", O_RDONLY | O_CLOEXEC);
+	if (randomfd < 0)
+		goto fail;
+	received = read(randomfd, epoch, sizeof epoch);
+	saved = errno;
+	close(randomfd);
+	if (received != sizeof epoch) {
+		errno = received < 0 ? saved : EIO;
+		goto fail;
+	}
+	server = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
+	if (server < 0 || bind(server, (struct sockaddr *)&address, sizeof address) < 0)
+		goto fail;
+	if (lstat(path, &st) < 0)
+		goto fail;
+	socketdev = st.st_dev;
+	socketino = st.st_ino;
+	if (chmod(path, 0660) < 0 || listen(server, CONTROL_CLIENTS) < 0)
+		goto fail;
+	atexit(control_close);
+	return 0;
+fail:
+	saved = errno;
+	control_close();
+	errno = saved;
+	return -1;
+}
diff --git a/control.h b/control.h
new file mode 100644
index 0000000000000000000000000000000000000000..02322462be87aad10a346a029ff75dad7d0ce28e
--- /dev/null
+++ b/control.h
@@ -0,0 +1,39 @@
+#ifndef CONTROL_H
+#define CONTROL_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <poll.h>
+
+#define CONTROL_CLIENTS 16
+#define CONTROL_POLLFDS (CONTROL_CLIENTS + 1)
+#define CONTROL_PAYLOAD 8192
+#define CONTROL_HEADER 24
+#define CONTROL_PACKET (CONTROL_HEADER + CONTROL_PAYLOAD)
+
+enum control_kind {
+	CONTROL_HELLO = 1, CONTROL_BEGIN, CONTROL_END, CONTROL_KEEPALIVE,
+	CONTROL_WRITE, CONTROL_REFRESH,
+	CONTROL_EVENT = 16, CONTROL_OBSERVATION = 17, CONTROL_WINDOW = 18,
+};
+#define CONTROL_REPLY UINT32_C(0x80000000)
+
+enum control_role { CONTROL_DESK = 1, CONTROL_GUI = 2, CONTROL_READER = 3 };
+enum control_status {
+	CONTROL_OK = 0, CONTROL_BUSY, CONTROL_INVALID, CONTROL_EXPIRED,
+	CONTROL_SHUTDOWN, CONTROL_OVERFLOW, CONTROL_NOT_OWNER,
+};
