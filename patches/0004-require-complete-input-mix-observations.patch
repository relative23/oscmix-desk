 		inputs[device->inputslen + i].stereo = true;
 		out = &outputs[i];
 		out->mix = calloc(device->inputslen + device->outputslen, sizeof *out->mix);
-		if (!out->mix) {
+		out->mix_observed = calloc(device->inputslen, sizeof *out->mix_observed);
+		if (!out->mix || !out->mix_observed) {
 			perror(NULL);
 			return -1;
 		}
