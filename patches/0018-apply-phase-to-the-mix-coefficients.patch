  * range flag in bit 15: TotalMix FX writes 0x9000 for 1 and 0x8800 for 0.5.
  * 0x4000 itself would read as -0.5, so 0.5 takes the x8 form as well. */
 static unsigned
-mixlevelvalue(float level)
+mixlevelvalue(float level, bool negative)
 {
 	long val;
+	unsigned range = 0;
 
 	val = lroundf(level * 0x8000);
 	assert(val >= 0);
 	assert(val <= 0x10000);
-	if (val >= 0x4000)
-		return 0x8000 | val >> 3;
-	return val;
+	if (val >= 0x4000) {
+		val >>= 3;
+		range = 0x8000;
+	}
+	return range | ((negative ? -val : val) & 0x7fff);
+}
+
+/* The UCX II has no phase of its own: its phase registers change nothing in
+ * the signal (measured through output loopback on all 20 outputs and inputs
+ * 1-4, 2026-11-07), and TotalMix FX turns the coefficients around itself.
+ * So does this backend: a cell is negative when exactly one of its input and
+ * output has phase on. Playback channels have no phase. */
+static bool
+mixnegative(const struct input *in, const struct output *out)
+{
+	bool phase;
+
+	phase = in < inputs + device->inputslen && in->phase;
+	return phase != out->phase;
 }
 
