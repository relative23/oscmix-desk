+/* Write the cells of one input or one output again with their sign. Only
+ * cached non-zero cells of unmuted inputs, as muteinput does: a zero is the
+ * same either way, a muted input's cells are written on unmute, and a cell
+ * this backend never learned is not overwritten. */
+static void
+rewritephase(const struct input *in, const struct output *out)
+{
+	const struct input *i;
+	const struct output *o;
+	float level;
+
+	for (o = outputs; o != outputs + device->outputslen; ++o) {
+		if (out && o != out)
+			continue;
+		for (i = inputs; i != inputs + device->inputslen + device->outputslen; ++i) {
+			if (in && i != in)
+				continue;
+			level = o->mix[i - inputs];
+			if (!i->mute && isfinite(level) && level > 0 && level <= 2)
+				setmixlevel(i, o, level);
+		}
+	}
+}
+
+static void
+phasechanged(struct input *in, struct output *out, bool val)
+{
+	bool *phase;
+
+	phase = in ? &in->phase : &out->phase;
+	if (*phase == val)
+		return;
+	*phase = val;
+	rewritephase(in, out);
+}
+
+static void
+setinputphase(struct context *ctx, struct oscmsg *msg)
+{
+	bool val;
+
+	if (!ctx->exact)
+		return;
+	val = oscgetint(msg);
+	if (oscend(msg) != 0)
+		return;
+	assert((unsigned)ctx->param.in < device->inputslen);
+	setval(ctx, val);
+	phasechanged(&inputs[ctx->param.in], NULL, val);
+}
+
+static void
+newinputphase(struct context *ctx, int val)
+{
+	assert((unsigned)ctx->param.in < device->inputslen);
+	phasechanged(&inputs[ctx->param.in], NULL, val != 0);
+	newbool(ctx, val);
+}
+
+static void
+setoutputphase(struct context *ctx, struct oscmsg *msg)
+{
+	bool val;
+
+	if (!ctx->exact)
+		return;
+	val = oscgetint(msg);
+	if (oscend(msg) != 0)
+		return;
+	assert((unsigned)ctx->param.out < device->outputslen);
+	setval(ctx, val);
+	phasechanged(NULL, &outputs[ctx->param.out], val);
+}
+
+static void
+newoutputphase(struct context *ctx, int val)
+{
+	assert((unsigned)ctx->param.out < device->outputslen);
+	phasechanged(NULL, &outputs[ctx->param.out], val != 0);
+	newbool(ctx, val);
+}
