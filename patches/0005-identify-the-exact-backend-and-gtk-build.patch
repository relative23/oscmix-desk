diff --git a/desk-build.h b/desk-build.h
new file mode 100644
index 0000000..1156f8e
--- /dev/null
+++ b/desk-build.h
@@ -0,0 +1,18 @@
+#include <stdio.h>
+#include <string.h>
+#include "desk-build-id.h"
+
+/* Available before MIDI descriptors, ALSA, a display or a session is opened. */
+static int
+desk_build_query(int argc, char *argv[])
+{
+	if (argc != 2)
+		return 0;
+	if (strcmp(argv[1], "--control-version") == 0)
+		puts("ODK1");
+	else if (strcmp(argv[1], "--desk-build-id") == 0)
+		puts(OSCMIX_DESK_BUILD_ID);
+	else
+		return 0;
+	return 1;
+}
