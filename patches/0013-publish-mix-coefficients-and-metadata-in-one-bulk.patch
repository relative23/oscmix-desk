+/* A setmix has at most four coefficients plus two DB/PAN pairs.
+ * This is one local synchronous packet, not a persistent register queue. */
+#define MIX_WRITE_MAX_WORDS 8
+struct mixwrites {
+	int count;
+	int regs[MIX_WRITE_MAX_WORDS];
+	unsigned vals[MIX_WRITE_MAX_WORDS];
+};
+
+static int
+mixwrite(struct mixwrites *writes, int reg, unsigned val)
+{
+	if (reg < 0 || reg > 0x7fff || writes->count < 0 ||
+	    writes->count >= MIX_WRITE_MAX_WORDS)
+		return -1;
+	writes->regs[writes->count] = reg;
+	writes->vals[writes->count++] = val;
+	return 0;
+}
+
+static void
+writemix(const struct mixwrites *writes)
+{
+	unsigned char buf[4 * MIX_WRITE_MAX_WORDS];
+	unsigned char sysexbuf[7 + 5 * MIX_WRITE_MAX_WORDS];
+	int i;
+
+	assert(writes->count >= 0 && writes->count <= MIX_WRITE_MAX_WORDS);
+	if (!writes->count)
+		return;
+	for (i = 0; i < writes->count; ++i)
+		putle32(buf + 4 * i, regword(writes->regs[i], writes->vals[i]));
+	writesysex(0, buf, 4 * writes->count, sysexbuf);
+}
