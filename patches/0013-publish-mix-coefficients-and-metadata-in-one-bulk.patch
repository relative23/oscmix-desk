+
+static int
+planmixlevel(struct mixwrites *writes, const struct input *in,
+    const struct output *out, float level)
+{
+	struct param p;
+	int reg, i;
+
+	if (!isfinite(level) || level < 0 || level > 2)
+		return -1;
+	p.in = in - inputs;
+	p.out = out - outputs;
+	reg = device->ctltoreg(MIX_LEVEL, &p);
+	/* Coefficient addresses must be distinct; DB/PAN intentionally share
+	 * their metadata address in the later setmix part of the packet. */
+	for (i = 0; i < writes->count; ++i)
+		if (writes->regs[i] == reg)
+			return -1;
+	return mixwrite(writes, reg, mixlevelvalue(level));
 }
 
