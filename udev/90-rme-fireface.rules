# RME Fireface UCX II (2a39:3fd9) -- oscmix-desk
#
# The ASMedia ASM4242 xHCI controller (1b21:2426) can fail its runtime
# suspend and remain in power/runtime_status=error.  Keep that controller
# active so a powered Fireface can always enumerate after disconnect/replug.
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1b21", ATTR{device}=="0x2426", TEST=="power/control", ATTR{power/control}="on"

# On plug-in: disable USB autosuspend (the interface must stay awake) and
# ask the user's systemd instance to start the oscmix backend.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="2a39", ATTR{idProduct}=="3fd9", ATTR{power/control}="on", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="oscmix.service"

# On unplug: sysfs attributes are gone, so match via ENV{PRODUCT}. Tagging
# the remove event lets the user manager retire its device unit. What
# ends the service on unplug is the backend: it exits when its device
# goes, and the session exits 0 with it. StopWhenUnneeded=yes in the
# unit would stop a service that only the pull-in started; the
# installer enables it, and an enabled unit is wanted by default.target
# and so never unneeded (ADR 0013, amended).
ACTION=="remove", SUBSYSTEM=="usb", ENV{PRODUCT}=="2a39/3fd9/*", TAG+="systemd"
